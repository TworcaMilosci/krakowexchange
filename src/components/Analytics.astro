---
import { SITE } from '../data/site.js';
const beacon = JSON.stringify({ token: SITE.analyticsToken });
---
<!-- Cloudflare Web Analytics. Wlasciciel i pracownicy moga wylaczyc liczenie swoich wejsc:
     /?nielicz wylacza na tym urzadzeniu, /?licz wlacza z powrotem. -->
<script is:inline define:vars={{ beacon }}>
(function () {
  var KEY = 'ekbs-nielicz';
  var off = false;
  var msg = '';
  try {
    var q = new URLSearchParams(location.search);
    if (q.has('nielicz')) { localStorage.setItem(KEY, '1'); msg = 'Statystyki: to urządzenie NIE jest już liczone.'; }
    if (q.has('licz')) { localStorage.removeItem(KEY); msg = 'Statystyki: to urządzenie jest znowu liczone.'; }
    off = localStorage.getItem(KEY) === '1';
    if (msg) {
      q.delete('nielicz'); q.delete('licz');
      var rest = q.toString();
      history.replaceState(null, '', location.pathname + (rest ? '?' + rest : '') + location.hash);
    }
  } catch (e) {}
  if (msg) {
    var show = function () {
      var d = document.createElement('div');
      d.setAttribute('role', 'status');
      d.textContent = msg;
      d.style.cssText = 'position:fixed;left:12px;right:12px;bottom:12px;z-index:99999;background:#111;color:#fff;padding:14px 16px;border-radius:10px;font:600 15px/1.4 system-ui,sans-serif;text-align:center;box-shadow:0 6px 24px rgba(0,0,0,.35)';
      document.body.appendChild(d);
      setTimeout(function () { d.remove(); }, 8000);
    };
    if (document.body) show(); else document.addEventListener('DOMContentLoaded', show);
  }
  if (off) return;
  var s = document.createElement('script');
  s.defer = true;
  s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
  s.setAttribute('data-cf-beacon', beacon);
  document.head.appendChild(s);
})();
</script>
<!-- End Cloudflare Web Analytics -->
