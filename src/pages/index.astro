                faq_a1: "Tak — ten sam kantor przy Floriańskiej 37 i ten sam właściciel. Zmieniliśmy nazwę, żeby mówiła wprost, kim jesteśmy: czarną owcą wśród krakowskich kantorów — tą, która gra w otwarte karty. Pełna tabela kupna i sprzedaży, 0% prowizji, żadnych gwiazdek. Zmieniła się nazwa — zasady zostały.",
                faq_q11: "Jaki macie spread?",
                faq_a11: "Kilka groszy. W detalu różnica między naszym kursem kupna a sprzedaży to maksymalnie 9 gr. W hurcie 1–3 gr*: taki kurs pokazujemy dla kwoty <span class=\"wf\">5 000 EUR</span>, a negocjować można nawet od równowartości 500 EUR. Obie tabele, detaliczna i hurtowa, są zawsze na tablicy i na tej stronie. (*w godzinach pracy polskiego rynku walutowego)",
                faq_q9: "Jaka jest różnica między złotym (zł) a PLN?",
                faq_a9: "Żadna — to ta sama waluta. PLN to międzynarodowy kod polskiego złotego (tak jak EUR dla euro), a zł to codzienny skrót, który zobaczysz na cenach. 10 zł = 10 PLN.",
                faq_q7: "Jakie waluty wymieniacie?",
                faq_a7: "<span class=\"curr\">🇪🇺 EUR (euro)</span><span class=\"curr\">🇺🇸 USD (dolary amerykańskie)</span><span class=\"curr\">🇬🇧 GBP (funty brytyjskie)</span><span class=\"curr\">🇨🇭 CHF (franki szwajcarskie)</span><span class=\"curr\">🇨🇦 CAD (dolary kanadyjskie)</span><span class=\"curr\">🇦🇺 AUD (dolary australijskie)</span><span class=\"curr\">🇩🇰 DKK (korony duńskie)</span><span class=\"curr\">🇸🇪 SEK (korony szwedzkie)</span><span class=\"curr\">🇳🇴 NOK (korony norweskie)</span><span class=\"curr\">🇨🇿 CZK (korony czeskie)</span><span class=\"curr\">🇭🇺 HUF (forinty węgierskie)</span><span class=\"curr\">🇯🇵 JPY (jeny japońskie)</span><span class=\"curr\">🇦🇪 AED (dirhamy ZEA)</span>— a także bilon euro oraz wycofane i zniszczone banknoty, po wcześniejszym kontakcie. Zdjęcia możesz podesłać na WhatsApp: <a href=\"https://wa.me/48889505057\" target=\"_blank\" rel=\"noopener\">wa.me/48889505057</a>",
                faq_q2: "Czy kursy podlegają negocjacji?",
                faq_a2: "Tak. Przy większych kwotach kurs ustalamy indywidualnie w okienku. Kurs hurtowy można negocjować nawet od równowartości 500 EUR; to zależy od kwoty, więc po prostu zapytaj. Tabela hurtowa na stronie pokazuje kursy dla kwoty <span class=\"wf\">5 000 EUR</span> (spread 1–3 gr*). (*w godzinach pracy polskiego rynku walutowego)",
                faq_q8: "Który kurs mnie dotyczy — kupno czy sprzedaż?",
                faq_a8: "Kursy zawsze podajemy od strony kantoru — to MY KUPUJEMY lub MY SPRZEDAJEMY walutę.<br><br><strong>Kupno</strong> = przynosisz nam walutę. Przy kursie kupna EUR 4,40 za 100 euro otrzymasz <strong>440 zł</strong>.<br><br><strong>Sprzedaż</strong> = kupujesz walutę od nas. Przy kursie sprzedaży GBP 5,10 za 100 funtów brytyjskich zapłacisz <strong>510 zł</strong>.",
                faq_q3: "Czy mogę zapłacić kartą?",
                faq_a3: "Wymieniamy wyłącznie gotówkę — jak każdy tradycyjny kantor w Polsce.",
                faq_q4: "Czy skupujecie stare, wycofane lub zniszczone banknoty?",
                faq_a4: "Tak — wycofane serie, zniszczone banknoty oraz bilon euro. Zadzwoń wcześniej pod <a href=\"tel:+48889505057\">+48 889 505 057</a> albo podeślij zdjęcia na WhatsApp: <a href=\"https://wa.me/48889505057\" target=\"_blank\" rel=\"noopener\">wa.me/48889505057</a>",
                faq_q5: "Czy potrzebuję dokumentu, żeby wymienić pieniądze?",
                faq_a5: "Przy codziennych kwotach — nie. Przepisy AML wymagają identyfikacji dopiero od transakcji o równowartości 15 000 EUR.",
                faq_q6: "Czy jesteście otwarci w weekendy?",
                faq_a6: "Sobota: 10:00–20:30<br>Niedziela: zamknięte<br>Poniedziałek–piątek: 09:30–20:30",
                footer_avoid: "Jak nie dać się oszukać w kantorze →",
                footer_scam: "Oszukał Cię kantor? Zobacz, co zrobić →",
                footer_nbp: "Działalność kantorowa wpisana do rejestru NBP",
                footer_privacy: "Polityka prywatności",
                toast_copied: "Skopiowano adres"
            }
        };

        let DATA = FALLBACK;
        let currentLang = "en";
        let activeDirection = "sell";

        const PAGE_LANG = "en";
        const ALT_URL = (location.protocol === "file:" ? "pl/" : "pl/".replace(/index\.html$/, ""));

        function detectLang() {
            try {
                const saved = localStorage.getItem("bs-lang");
                if (saved === "pl" || saved === "en") return saved;
            } catch (e) {}
            return (navigator.language || "").toLowerCase().startsWith("pl") ? "pl" : "en";
        }

        function hasWholesale() {
            return Object.values(DATA.rates).some(r => typeof r.buyHurt === "number" && typeof r.sellHurt === "number");
        }

        function setLanguage(lang) {
            if (lang !== PAGE_LANG) {
                try { localStorage.setItem("bs-lang", lang); } catch (e) {}
                window.location.href = ALT_URL;
                return;
            }
            currentLang = lang;
            document.documentElement.lang = lang;
            const t = translations[lang];
            document.querySelectorAll("[data-i18n]").forEach(el => {
                const key = el.getAttribute("data-i18n");
                if (!t[key]) return;
                if (el.hasAttribute("data-i18n-html")) el.innerHTML = t[key];
                else el.textContent = t[key];
            });
            document.getElementById("btn-en").classList.toggle("active", lang === "en");
            document.getElementById("btn-pl").classList.toggle("active", lang === "pl");
            renderBoard();
            renderBoardNote();
            calculate();
        }

        function fmtRate(n) {
            const dec = (String(n).split(".")[1] || "").length;
            return n.toFixed(Math.min(Math.max(dec, 2), 3)); // najwyżej 4 cyfry w tabeli
        }

        function fmtSpread(d) {
            const milli = Math.round(d * 1000);
            if (currentLang === "pl") return String(milli / 10).replace(".", ",") + " gr";
            return (milli / 1000).toFixed(milli % 10 === 0 ? 2 : 3) + " PLN";
        }

        function tierRows(buyKey, sellKey) {
            return Object.entries(DATA.rates)
                .filter(([, r]) => typeof r[buyKey] === "number" && typeof r[sellKey] === "number")
                .map(([code, r]) => `
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="text-xl mr-2" aria-hidden="true">${FLAGS[code] || ""}</span>
                        <span class="display text-lg sm:text-xl">${code}</span>
                    </td>
                    <td class="px-3 py-4 text-right board-digit num text-xl sm:text-2xl">${fmtRate(r[buyKey])}</td>
                    <td class="px-6 py-4 text-right board-digit num text-xl sm:text-2xl">${fmtRate(r[sellKey])}</td>
                </tr>`).join("");
        }

        function tierSpreads(buyKey, sellKey) {
            return Object.entries(DATA.rates)
                .filter(([, r]) => typeof r[buyKey] === "number" && typeof r[sellKey] === "number")
                .map(([code, r]) => code + " " + fmtSpread(r[sellKey] - r[buyKey])).join(" · ");
        }

        function renderBoard() {
            document.getElementById("board-body").innerHTML = tierRows("buy", "sell");
            document.getElementById("wholesale-block").hidden = !hasWholesale() && !DATA._hurtError;
            document.getElementById("board-body-hurt").innerHTML = DATA._hurtError ? `<tr><td colspan="3" class="px-6 py-6 text-center display text-lg">ERROR</td></tr>` : tierRows("buyHurt", "sellHurt");
            document.querySelector("#wholesale-block .spread-line").hidden = !!DATA._hurtError;
            document.getElementById("spread-wholesale").textContent = tierSpreads("buyHurt", "sellHurt");
            const ai = DATA.wholesaleAutoInfo;
            let stamp = DATA.updated || "—";
            if (ai && ai.mode !== "manual" && ai.generatedAt) {
                const g = new Date(ai.generatedAt);
                if (!isNaN(g)) stamp = g.toLocaleDateString("sv-SE", { timeZone: "Europe/Warsaw" }) + " " + g.toLocaleTimeString("pl-PL", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" });
            }
            document.getElementById("board-date").textContent = stamp;
            const sl = document.querySelector('[data-i18n="spread_label"]');
            if (sl) sl.textContent = (ai && ai.mode !== "manual" && ai.period === "weekend") ? translations[currentLang].spread_weekend : translations[currentLang].spread_label;
            document.querySelectorAll(".wf").forEach(el => { el.textContent = DATA.wholesaleFrom || ""; });

            // rates older than 2 days: say so instead of pretending they are today's
            const stale = document.getElementById("stale-note");
            const age = (Date.now() - new Date(String(DATA.updated).slice(0, 10) + "T00:00:00").getTime()) / 86400000;
            if (isFinite(age) && age >= 3) {
                stale.textContent = translations[currentLang].stale_note.replace("{D}", DATA.updated);
                stale.hidden = false;
            } else {
                stale.hidden = true;
            }
        }

        function renderBoardNote() {
            const t = translations[currentLang];
            document.getElementById("board-note").textContent = t.retail_note;
            const auto = DATA.wholesaleAutoInfo && DATA.wholesaleAutoInfo.mode !== "manual" ? DATA.wholesaleAutoInfo : null;
            let noteText = t.wholesale_note.replace("{X}", DATA.wholesaleFrom || "");
            if (auto) {
                let when = "";
                const q = new Date(auto.quoteTime);
                if (auto.source === "nbp") when = "NBP " + auto.quoteTime;
                else if (!isNaN(q)) when = q.toLocaleTimeString(currentLang === "pl" ? "pl-PL" : "en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" });
                noteText = t.wholesale_note_auto.replace("{T}", when);
            }
            if (DATA._hurtError) noteText = t.wholesale_error;
            document.getElementById("wholesale-note").textContent = noteText;
            document.getElementById("reserve-row").hidden = !auto && !DATA._hurtError;
            document.getElementById("reserve-wa").href = "https://wa.me/48889505057?text=" + encodeURIComponent(t.reserve_msg);
        }

        function renderAlsoBuy() {
            const wrap = document.getElementById("also-chips");
            wrap.innerHTML = (DATA.alsoBuy || []).map(code =>
                `<span class="chip"><span class="mr-1.5" aria-hidden="true">${FLAGS[code] || ""}</span>${code}</span>`
            ).join("");
        }

        function renderCurrencyOptions() {
            const select = document.getElementById("currency");
            const prev = select.value;
            select.innerHTML = Object.keys(DATA.rates).map(code =>
                `<option value="${code}">${FLAGS[code] || ""} ${code}</option>`
            ).join("");
            if (prev && DATA.rates[prev]) select.value = prev;
        }

        function setDirection(dir) {
            activeDirection = dir;
            const sell = document.getElementById("dir-sell");
            const buy = document.getElementById("dir-buy");
            const on = ["border-neutral-900", "text-neutral-900"];
            const off = ["border-transparent", "text-neutral-400"];
            (dir === "sell" ? [[sell, on, off, true], [buy, off, on, false]]
                            : [[buy, on, off, true], [sell, off, on, false]])
                .forEach(([el, add, remove, selected]) => {
                    el.classList.add(...add); el.classList.remove(...remove);
                    el.setAttribute("aria-selected", selected);
                });
            calculate();
        }

        function calculate() {
            const amount = parseFloat(document.getElementById("amount").value) || 0;
            const code = document.getElementById("currency").value;
            const r = DATA.rates[code];
            if (!r) return;
            const t = translations[currentLang];
            const min = DATA.wholesaleMinAmount || 1000;
            const hasW = typeof r.buyHurt === "number" && typeof r.sellHurt === "number";
            const useW = hasW && amount >= min;
            const rate = activeDirection === "sell"
                ? (useW ? r.buyHurt : r.buy)
                : (useW ? r.sellHurt : r.sell);
            document.getElementById("result-label").textContent = activeDirection === "sell" ? t.result_receive : t.result_pay;
            document.getElementById("result").textContent = (amount * rate).toLocaleString(currentLang === "pl" ? "pl-PL" : "en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById("applied-rate").textContent = fmtRate(rate);
            document.getElementById("rate-tier").textContent = useW ? " · " + t.calc_wholesale_applied : (hasW && amount >= 500 ? " · " + t.calc_wholesale_ask : "");
        }

        function copyAddress() {
            const text = "Floriańska 37, 31-019 Kraków";
            const done = () => {
                const toast = document.getElementById("toast");
                toast.classList.remove("translate-y-20", "opacity-0");
                setTimeout(() => toast.classList.add("translate-y-20", "opacity-0"), 2500);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done).catch(done);
            } else {
                const ta = document.createElement("textarea");
                ta.value = text; document.body.appendChild(ta); ta.select();
                document.execCommand("copy"); document.body.removeChild(ta); done();
            }
        }

        async function loadRates() {
            // 1) /api/rates: detal ręczny + hurt liczony z rynku (funkcja na hostingu)
            // 2) /rates.json: same kursy ręczne (gdy funkcja nie odpowiada)
            const sources = ["/api/rates?t=" + Date.now(), "/rates.json?t=" + Date.now()];
            for (const url of sources) {
                try {
                    const res = await fetch(url, { cache: "no-store" });
                    if (res.ok) {
                        const json = await res.json();
                        if (json && json.rates) {
                            DATA = json;
                            // Hurt liczy tylko /api/rates. Gdy odpowiedział sam plik rates.json albo funkcja zgłosiła błąd,
                            // nie pokazujemy starych kursów ręcznych, tylko komunikat o błędzie.
                            const autoOn = !(json.wholesaleAuto && json.wholesaleAuto.enabled === false);
                            const info = json.wholesaleAutoInfo;
                            DATA._hurtError = autoOn && (!info || info.mode === "error");
                            if (DATA._hurtError) Object.values(DATA.rates).forEach(r => { r.buyHurt = null; r.sellHurt = null; });
                            break;
                        }
                    }
                } catch (e) {}
            }
            renderBoard();
            renderAlsoBuy();
            renderCurrencyOptions();
            renderBoardNote();
            calculate();
        }

        document.getElementById("year").textContent = new Date().getFullYear();
        renderBoard();
        renderAlsoBuy();
        renderCurrencyOptions();
        if (detectLang() === "pl") {
            window.location.replace(ALT_URL);
        } else {
            setLanguage("en");
            loadRates();
        }
    </script>
