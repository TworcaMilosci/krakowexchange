<script is:inline type="application/ld+json">{"@context": "https://schema.org", "@type": "Service", "name": "Wymiana zniszczonych i wycofanych banknotów w Krakowie", "description": "Podarty, zalany albo wycofany z obiegu banknot obcej waluty? Wyślij zdjęcie na WhatsApp, odpowiemy, czy go skupimy i po jakim kursie. Floriańska 37, Kraków.", "url": "https://kantorblacksheep.pl/pl/wymiana-zniszczonych-wycofanych-banknotow-krakow", "inLanguage": "pl", "areaServed": {"@type": "City", "name": "Kraków"}, "provider": {"@type": "FinancialService", "@id": "https://kantorblacksheep.pl/#business", "name": "Exchange Kantor Black Sheep", "url": "https://kantorblacksheep.pl", "telephone": "+48889505057", "address": {"@type": "PostalAddress", "streetAddress": "Floriańska 37", "addressLocality": "Kraków", "postalCode": "31-019", "addressCountry": "PL"}}}</script>
