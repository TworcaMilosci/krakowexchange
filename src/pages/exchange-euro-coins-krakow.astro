---
import Logo from '../components/Logo.astro';
import GeoMeta from '../components/GeoMeta.astro';
import Analytics from '../components/Analytics.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exchange euro coins in Kraków | Exchange Kantor Black Sheep</title>
    <GeoMeta />
    <meta property="og:image" content="https://kantorblacksheep.pl/images/front-og-2.jpg">
    <meta name="description" content="Left with euro coins after a trip? We buy euro coins at Floriańska 37 in Kraków&#x27;s Old Town. Message us the amount on WhatsApp and get the rate before you come.">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://kantorblacksheep.pl/exchange-euro-coins-krakow">
    <link rel="alternate" hreflang="en" href="https://kantorblacksheep.pl/exchange-euro-coins-krakow">
    <link rel="alternate" hreflang="pl" href="https://kantorblacksheep.pl/pl/skup-bilonu-euro-krakow">
    <link rel="alternate" hreflang="x-default" href="https://kantorblacksheep.pl/exchange-euro-coins-krakow">

    <link rel="icon" type="image/png" sizes="64x64" href="images/favicon-64.png">
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png">

    <script is:inline type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Why do I need to contact you first?", "acceptedAnswer": {"@type": "Answer", "text": "So you know the rate and we know the amount before you come. Coins are counted by hand, and the rate for coins is set separately from the banknote rates on our board."}}, {"@type": "Question", "name": "Which coins do you buy?", "acceptedAnswer": {"@type": "Answer", "text": "Euro coins. Tell us which denominations you have and we will confirm."}}, {"@type": "Question", "name": "Do you also buy euro banknotes?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, at the rates on our board, with no need to contact us first. Both retail and wholesale rates are published on our home page."}}]}</script>
    <link rel="stylesheet" href="styles.css">
    <style is:inline>
        :root { --ink:#0a0a0a; --panel:#141414; --mist:#a3a3a3; --dim:#6b6b6b; }
        body { font-family:'Montserrat','Montserrat Fallback',sans-serif; background:var(--ink); color:#fff; }
        .lockup { display:inline-block; line-height:1; text-transform:uppercase; }
        .lockup .top { display:block; font-weight:800; color:#fff; font-size:1.9em; letter-spacing:0.068em; }
        .lockup .sub { display:block; font-weight:700; color:var(--mist); font-size:1em; letter-spacing:0em; margin-top:0.22em; }
        .lockup .sub b { color:#fff; font-weight:800; }
        @media (max-width: 400px) { .lockup { font-size: 0.55rem !important; } .lang-btn { padding: 0.3rem 0.5rem; } }
        .display { font-weight:800; text-transform:uppercase; letter-spacing:0.06em; }
        .eyebrow { font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.28em; color:var(--mist); }
        .num { font-variant-numeric: tabular-nums; }
        .lang-btn { padding:0.35rem 0.7rem; font-size:0.75rem; font-weight:700; color:var(--dim); border-radius:9999px; text-decoration:none; }
        .lang-btn.active { color:var(--ink); background:#fff; }
        .btn-solid { background:#fff; color:var(--ink); border-radius:9999px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; font-size:0.85rem; padding:1rem 2rem; display:inline-flex; align-items:center; justify-content:center; text-align:center; }
        .btn-line { border:1px solid #fff; color:#fff; border-radius:9999px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; font-size:0.85rem; padding:1rem 2rem; display:inline-flex; align-items:center; justify-content:center; text-align:center; }
        .cta-row { display:flex; flex-wrap:wrap; gap:0.75rem; justify-content:center; }
        a:focus-visible, button:focus-visible { outline:2px solid #fff; outline-offset:2px; }
    </style>
<script is:inline type="application/ld+json">{"@context": "https://schema.org", "@type": "Service", "name": "Exchange euro coins in Kraków", "description": "Left with euro coins after a trip? We buy euro coins at Floriańska 37 in Kraków's Old Town. Message us the amount on WhatsApp and get the rate before you come.", "url": "https://kantorblacksheep.pl/exchange-euro-coins-krakow", "inLanguage": "en", "areaServed": {"@type": "City", "name": "Kraków"}, "provider": {"@type": "FinancialService", "@id": "https://kantorblacksheep.pl/#business", "name": "Exchange Kantor Black Sheep", "url": "https://kantorblacksheep.pl", "telephone": "+48889505057", "address": {"@type": "PostalAddress", "streetAddress": "Floriańska 37", "addressLocality": "Kraków", "postalCode": "31-019", "addressCountry": "PL"}}}</script>
</head>
<body>

    <nav class="fixed top-0 w-full z-50 bg-black/90 backdrop-blur border-b border-neutral-800 px-4 sm:px-6">
        <div class="max-w-6xl mx-auto flex items-center justify-between h-16">
            <a href="./" class="flex items-center gap-3">
                <Logo variant="lockup" base="" />
            </a>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1 border border-neutral-700 rounded-full p-0.5">
                    <a class="lang-btn active" href="#" hreflang="en">EN</a>
                    <a class="lang-btn" href="pl/skup-bilonu-euro-krakow" hreflang="pl">PL</a>
                </div>
                <span class="hidden sm:inline-flex"><a href="./" class="eyebrow hover:text-white transition-colors">← HOME</a></span>
                <a href="./" aria-label="Home" class="sm:hidden inline-flex items-center justify-center w-10 h-10 rounded-full border border-white text-white text-lg">←</a>
            </div>
        </div>
    </nav>

    <main class="pt-32 pb-20 px-4 sm:px-6">
        <div class="max-w-3xl mx-auto">
            <p class="eyebrow mb-4">Euro coins · Kraków Old Town</p>
            <h1 class="display text-3xl sm:text-5xl leading-tight mb-6">Exchange euro coins in Kraków</h1>
            <p class="text-neutral-400 text-lg mb-12 max-w-2xl">Most banks and exchange offices in Poland take banknotes only. Exchange Kantor Black Sheep buys euro coins at Floriańska 37, after a short message, so you know the rate before you walk over.</p>

            <div class="space-y-4">
                <div class="bg-[--panel] border border-neutral-800 rounded-2xl p-8">
                    <p class="eyebrow mb-2">01</p>
                    <h2 class="font-bold text-xl mb-2">Count your coins</h2>
                    <p class="text-neutral-400 text-sm leading-relaxed">Add them up roughly, by denomination. A photo of the pile works too.</p>
                </div>
                <div class="bg-[--panel] border border-neutral-800 rounded-2xl p-8">
                    <p class="eyebrow mb-2">02</p>
                    <h2 class="font-bold text-xl mb-2">Message or call us</h2>
                    <p class="text-neutral-400 text-sm leading-relaxed">Send the total on WhatsApp or call +48 889 505 057. We reply with the rate for coins and confirm when to come.</p>
                </div>
                <div class="bg-[--panel] border border-neutral-800 rounded-2xl p-8">
                    <p class="eyebrow mb-2">03</p>
                    <h2 class="font-bold text-xl mb-2">Come to Floriańska 37</h2>
                    <p class="text-neutral-400 text-sm leading-relaxed">Between St. Florian&#x27;s Gate and the Main Square. Open Monday to Saturday, 09:30–20:30. You get złoty in cash at the counter, with 0% commission.</p>
                </div>
            </div>

            <div class="mt-10 bg-[--panel] border border-neutral-800 rounded-2xl p-8 text-center">
                <div class="cta-row">
                    <a href="https://wa.me/48889505057?text=Hi%2C%20I%20have%20euro%20coins%20to%20exchange.%20Amount%3A%20" target="_blank" rel="noopener" class="btn-solid">Message us on WhatsApp</a>
                    <a href="./#rates" class="btn-line">Today&#x27;s rates</a>
                </div>
                <p class="text-neutral-400 text-sm mt-4"><a href="tel:+48889505057" class="num underline underline-offset-4">+48 889 505 057</a></p>
            </div>

            <h2 class="display text-xl mt-10 mb-4">Questions about euro coins</h2>
            <div class="space-y-4">
                <div class="bg-[--panel] border border-neutral-800 rounded-2xl p-8">
                    <h3 class="font-bold text-xl mb-2">Why do I need to contact you first?</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">So you know the rate and we know the amount before you come. Coins are counted by hand, and the rate for coins is set separately from the banknote rates on our board.</p>
                </div>
                <div class="bg-[--panel] border border-neutral-800 rounded-2xl p-8">
                    <h3 class="font-bold text-xl mb-2">Which coins do you buy?</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">Euro coins. Tell us which denominations you have and we will confirm.</p>
                </div>
                <div class="bg-[--panel] border border-neutral-800 rounded-2xl p-8">
                    <h3 class="font-bold text-xl mb-2">Do you also buy euro banknotes?</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">Yes, at the rates on our board, with no need to contact us first. Both retail and wholesale rates are published on our home page.</p>
                </div>
            </div>

            <p class="text-neutral-400 text-sm mt-10 text-center"><a href="exchange-damaged-withdrawn-banknotes-krakow" class="underline underline-offset-4">Damaged or withdrawn banknotes? We buy those too →</a></p>
        </div>
    </main>

    <footer class="border-t border-neutral-800 py-10 px-4 sm:px-6 text-center">
        <p class="text-xs text-neutral-500">© <span class="num">2026</span> Exchange Kantor Black Sheep · Floriańska 37, Kraków · <a href="privacy" class="underline underline-offset-4">Privacy / Prywatność</a></p>
    </footer>
<Analytics />
</body>
</html>
